# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
# You only need the key(s) for the providers referenced in config.yaml.
# The default config uses Anthropic for stages 2/4/5/6 and ElevenLabs for
# stage 7 narration.

# Anthropic - default provider for every LLM stage (shortlist, rank, extract,
# script). Required.
ANTHROPIC_API_KEY=

# ElevenLabs - Stage 7 narration with the default config (DECISIONS.md D22).
# ~$0.47 per episode. Needs the text_to_speech permission; voices_read is only
# required if you want to enumerate your account's voices.
ELEVENLABS_API_KEY=

# OpenAI - optional. Needed only if a stage is pointed at an OpenAI model, or if
# tts.provider is set to `openai` (~$0.06 per episode).
OPENAI_API_KEY=

# Groq - optional. Useful for a cheaper Stage 2 shortlist pass (DECISIONS.md D6).
GROQ_API_KEY=

# Set tts.provider to `macos` in config.yaml for free offline narration with no
# key at all - quality is well below the hosted engines (DECISIONS.md D21/D22).

# --- Stage 10 upload (SPEC.md Stage 10) ---------------------------------------
# Only needed with `upload.enabled: true` in config.yaml. The default is dry-run,
# which needs no credentials at all.
#
# Client ID/secret: an OAuth client of type "Desktop app" in the Google Cloud
# project. Refresh token: run `pipeline youtube-auth` once, then paste the value
# it prints. It is a long-lived credential for the channel - store it as a secret
# and never commit it.
#
# Public/scheduled publishing additionally requires the Google Cloud project to
# have passed a YouTube API compliance audit. Without it, uploads are locked to
# private and publishAt is ignored.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
